{
  "name": "editin",
  "version": "0.1.1",
  "private": true,
  "description": "누구나 쉽게, 그러나 제대로 하는 영상 편집기",
  "type": "module",
  "scripts": {
    "start": "npx --yes http-server -c-1 -p 8080 .",
    "lint": "npx --yes eslint js/",
    "yt-helper": "node tools/yt-helper.mjs",
    "app": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  },
  "main": "electron/main.mjs",
  "author": "editin",
  "homepage": "https://github.com/Jedidiah1926/editin",
  "build": {
    "appId": "app.editin.editor",
    "productName": "editin",
    "copyright": "editin",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "electron/**",
      "tools/yt-helper.mjs",
      "build/icon.png",
      "package.json",
      "node_modules/ffmpeg-static/**",
      "!node_modules/ffmpeg-static/*.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "bin",
        "filter": [
          "yt-dlp*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "editin-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "editin",
      "installerLanguages": [
        "ko_KR"
      ],
      "language": "1042",
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Jedidiah1926/editin.git"
  }
}
